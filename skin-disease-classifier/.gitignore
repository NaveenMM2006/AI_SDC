# ==========================================
venv/
.venv/
env/
.env
bin/
lib/
include/
share/
pyvenv.cfg
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# 2. Datasets (NEVER commit large data to Git)
# ==========================================
